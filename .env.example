# -----------------------------------------------------------------------------
# StoryKeeper AI - Environment Variables
# -----------------------------------------------------------------------------

# Neon Database (PostgreSQL)
# Pooled connection string (with -pooler in host) for application runtime
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"
# Direct connection string for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require"

# Better Auth Configuration
BETTER_AUTH_SECRET="storykeeper-super-secret-auth-key-change-in-production-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenRouter AI (Speech-to-Text & LLM)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
OPENROUTER_STT_MODEL="openai/whisper-large-v3"
OPENROUTER_LLM_MODEL="anthropic/claude-3.5-sonnet"

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="storykeeper-audio"
R2_PUBLIC_URL="https://storage.storykeeper.org"

# Resend Email (Password resets)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="StoryKeeper Archive <archive@storykeeper.org>"

# Seed Admin Credentials
SEED_ADMIN_EMAIL="admin@storykeeper.org"
SEED_ADMIN_PASSWORD="StoryKeeper2026!Admin"

# Cron Secret (Worker / Scheduled Jobs)
CRON_SECRET="storykeeper-cron-secret-2026"
